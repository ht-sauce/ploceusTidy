{
  "name": "ploceus-tidy",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-spec": "node scripts/check-spec.mjs",
    "tauri:dev": "tauri dev --config desktop/tauri.conf.json --release",
    "tauri:build": "tauri build --config desktop/tauri.conf.json && node scripts/collect-installer.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tauri-apps/api": "2.12.4",
    "@wangeditor-next/editor": "6.5.1",
    "@wangeditor-next/editor-for-react": "6.5.1",
    "antd": "6.6.7",
    "konva": "^10.9.0",
    "pinyin-pro": "3.29.5",
    "rbush": "^4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/rbush": "^4.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
